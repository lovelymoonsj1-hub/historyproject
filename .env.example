# Supabase project settings (set these in Vercel Project Settings → Environment Variables)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
# Server-only Supabase secret for teacher password management. Never expose this in client code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
